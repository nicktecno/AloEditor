# Credenciais do Google Cloud Console para o AloEditor
# Obtenha em: https://console.cloud.google.com/apis/credentials
# 1. Ative: Google Drive API e Google Picker API
# 2. Crie uma Chave de API (API Key)
# 3. Crie um ID do cliente OAuth 2.0 (Aplicativo da Web)
#    - Origens JavaScript autorizadas: http://localhost:3001
#    - URIs de redirecionamento autorizados: http://localhost:3001

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
